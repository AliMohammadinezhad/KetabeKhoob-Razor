@page "{handler?}"
@using Eshop.RazorPage.Infrastructure.Utils
@using KetabeKhoob.Razor.Infrastructure
@model KetabeKhoob.Razor.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "مدیریت محصولات";
    ViewData["Selected"] = "Products";
}
<form class="card shadow-lg">
    <div class="card-header text-left">
        <a asp-page="Index" class="btn btn-danger btn-sm">حذف فیلتر</a>
        <button type="submit" class="btn btn-primary btn-sm">فیلتر</button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <label>شناسه محصول</label>
                <input type="number" asp-for="FilterParams.Id" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>عنوان محصول</label>
                <input type="text" asp-for="FilterParams.Title" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>slug</label>
                <input type="text" asp-for="FilterParams.Slug" class="form-control" />
            </div>
        </div>
    </div>
</form>
<section>
    <h2>@ViewData["Title"]</h2>
    <a asp-page="Add" class="btn btn-success mb-2">افزودن محصول</a>
    <div class="table-responsive card card-body p-0 text-center">
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th>عکس</th>
                    <th>عنوان</th>
                    <th>slug</th>
                    <th>تاریخ ثبت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.ProductFilterResult.Data)
                {
                    <tr>
                        <td>
                            <img src="@Directories.GetProductImage(product.ImageName)" style="max-width: 250px" alt="@product.Title" />
                        </td>
                        <td>@product.Title</td>
                        <td>@product.Slug</td>
                        <td>@product.CreationDate.ToPersianDateTime()</td>
                        <td>
                            <a asp-page="Edit" class="btn btn-info btn-sm" asp-route-productId="@product.Id">ویرایش</a>
                            <a asp-page="Galleries/Index" class="btn btn-light-primary btn-sm" asp-route-productId="@product.Id">گالری تصاویر</a>
                            <delete-item url="@Url.Page("Index", "DeleteProduct", new { productId = product.Id })">حذف</delete-item>
                        </td>
                    </tr>
                }
                @if (Model.ProductFilterResult.Data.Any() == false)
                {
                    <tr>
                        <td colspan="5" class="text-center">موردی برای نمایش وجود ندارد.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>